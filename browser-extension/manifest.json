{
  "manifest_version": 3,
  "name": "Siphon Download Capture",
  "version": "0.3.0",
  "description": "自动接管 Chrome / Edge 浏览器下载，支持 HLS (.m3u8) 流媒体实时嗅探、磁力链接、右键任意资源与页面批量提交至 Siphon 多线程下载器",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Siphon 下载捕获",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
